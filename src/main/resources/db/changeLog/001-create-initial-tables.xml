<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.27.xsd">

    <changeSet id="1" author="mark.shkulepa">
        <createTable tableName="users">
            <column name="id" type="BIGSERIAL" autoIncrement="true">
                <constraints primaryKey="true"/>
            </column>
            <column name="first_name" type="VARCHAR(255)"/>
            <column name="last_name" type="VARCHAR(255)"/>
            <column name="email" type="VARCHAR(255)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="password" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="role" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>
            <column name="status" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

    <changeSet id="2" author="mark.shkulepa">
        <createTable tableName="games">
            <column name="id" type="BIGSERIAL" autoIncrement="true">
                <constraints primaryKey="true"/>
            </column>
            <column name="name" type="VARCHAR(255)">
                <constraints nullable="false" unique="true"/>
            </column>
        </createTable>
    </changeSet>

    <changeSet id="3" author="mark.shkulepa">
        <createTable tableName="game_objects">
            <column name="id" type="BIGSERIAL" autoIncrement="true">
                <constraints primaryKey="true"/>
            </column>
            <column name="title" type="VARCHAR(255)"/>
            <column name="text" type="TEXT"/>
            <column name="created_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP"/>
            <column name="updated_at" type="TIMESTAMP"/>
            <column name="user_id" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_gameobject_user" references="users(id)"/>
            </column>
            <column name="game_id" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_gameobject_game" references="games(id)"/>
            </column>
        </createTable>
    </changeSet>

    <changeSet id="4" author="mark.shkulepa">
        <createTable tableName="comments">
            <column name="id" type="BIGSERIAL" autoIncrement="true">
                <constraints primaryKey="true"/>
            </column>
            <column name="message" type="TEXT"/>
            <column name="rating" type="INT">
                <constraints nullable="false"/>
            </column>
            <column name="status" type="VARCHAR(50)" defaultValue="PENDING">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="seller_id" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_comment_seller" references="users(id)"/>
            </column>
            <column name="author_id" type="BIGINT">
                <constraints nullable="true" foreignKeyName="fk_comment_author" references="users(id)"/>
            </column>
        </createTable>
    </changeSet>

    <changeSet id="5" author="mark.shkulepa">
        <createTable tableName="seller_ratings">
            <column name="seller_id" type="BIGINT">
                <constraints primaryKey="true" foreignKeyName="fk_rating_seller" references="users(id)"/>
            </column>
            <column name="rating_value" type="NUMERIC(3, 2)"/> </createTable>
    </changeSet>

</databaseChangeLog>